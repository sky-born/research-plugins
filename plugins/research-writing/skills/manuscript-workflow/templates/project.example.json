{
  "project": "논문 이름",
  "kind": "journal",
  "description": "한 줄 설명",

  "manuscript": {
    "source_dir": "manuscript",
    "chapters": [
      { "n": 1, "file": "intro.md" },
      { "n": 2, "file": "results.md" }
    ],
    "references": "bib.md",
    "build_script": "build.py",
    "figure_dir": "figures",
    "output_pattern": "원고_v*.docx"
  },

  "tracker": {
    "index": "수정필요_목록.md",
    "pending": "수정필요_대기.md",
    "record_index": "수정필요_색인.md",
    "literature": "수정필요_문헌.md",
    "proposals": "수정필요_제안.md",
    "records_dir": "완료기록",
    "archive": "완료기록/이관_DB.md",
    "record_prefix": "E",
    "movable_prefixes": ["A", "B", "C", "D"],
    "index_size_limit_kb": 40,
    "triggers": ["지금", "해당 절 작업 시", "사용자 판단", "자료 확보 후", "최종 제출 직전"],
    "section_markers": [],
    "record_index_exclude": [],
    "checkpoint": "조사/CHECKPOINT.md"
  },

  "sync": {
    "shared_extra": ["도판소스/INDEX.md"],
    "snapshot_dir": "보관/추적_백업",
    "stale_days": 2,
    "snapshot_days": 30,
    "snapshot_days_others": 90,
    "snapshot_min": 10,
    "snapshot_max": 20,
    "snapshot_max_local": 100,
    "ack_hours": 4,
    "known_gaps": [],
    "rewrite_ok": [],
    "survival_pct": 70
  },

  "markers": ["수정필요_목록.md", "manuscript/build.py"],

  "procedure": ".claude/skills/<프로젝트 스킬>/SKILL.md"
}
