{
  "project": "Paper title",
  "kind": "journal",
  "description": "One-line description",

  "manuscript": {
    "source_dir": "manuscript",
    "chapters": [
      { "n": 1, "file": "intro.md" },
      { "n": 2, "file": "results.md" }
    ],
    "references": "bib.md",
    "build_script": "build.py",
    "figure_dir": "figures",
    "output_pattern": "manuscript_v*.docx"
  },

  "tracker": {
    "index": "tracker_index.md",
    "pending": "tracker_pending.md",
    "record_index": "tracker_records_index.md",
    "literature": "tracker_literature.md",
    "proposals": "tracker_proposals.md",
    "records_dir": "records",
    "archive": "records/archive.md",
    "record_prefix": "E",
    "movable_prefixes": ["A", "B", "C", "D"],
    "index_size_limit_kb": 40,
    "triggers": ["now", "when working on the section", "user decision", "when data is available", "before final submission"],
    "section_markers": [],
    "record_index_exclude": [],
    "checkpoint": "notes/CHECKPOINT.md"
  },

  "sync": {
    "shared_extra": ["figures/INDEX.md"],
    "snapshot_dir": "archive/tracker_backup",
    "stale_days": 2,
    "snapshot_days": 30,
    "snapshot_days_others": 90,
    "snapshot_min": 10,
    "snapshot_max": 20,
    "snapshot_max_local": 100,
    "ack_hours": 4,
    "known_gaps": [],
    "rewrite_ok": [],
    "survival_pct": 70
  },

  "markers": ["tracker_index.md", "manuscript/build.py"],

  "procedure": ".claude/skills/<project skill>/SKILL.md"
}
